#!/usr/bin/env python3
"""Package existing native XCFrameworks and update the release manifest."""
import argparse
import hashlib
import json
import re
import subprocess
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LIBRARIES = {
    "KasumiDagreNative": "kasumi_dagre",
    "KasumiLineBreakNative": "kasumi_linebreak",
    "KasumiHyphenationNative": "kasumi_hyphenation",
    "KasumiSyntaxNative": "kasumi_syntax",
}

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--version", required=True)
    parser.add_argument("--repository", required=True)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    if not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?", args.version):
        parser.error("version must be a numeric semantic version, optionally with a prerelease")
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", args.repository):
        parser.error("repository must be owner/name")
    args.output.mkdir(parents=True, exist_ok=True)
    entries = []
    for name, library in LIBRARIES.items():
        source = ROOT / ".build/native" / f"{library}.xcframework"
        if not source.is_dir():
            raise SystemExit(f"Missing {source}; run make native first")
        archive = args.output / f"{library}.xcframework.zip"
        with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=6) as out:
            for path in sorted(source.rglob("*")):
                if path.is_file():
                    out.write(path, Path(source.name) / path.relative_to(source))
        checksum = hashlib.sha256(archive.read_bytes()).hexdigest()
        url = f"https://github.com/{args.repository}/releases/download/{args.version}/{archive.name}"
        entries.append(f'    "{name}": (url: "{url}", checksum: "{checksum}"),')
    manifest = ROOT / "Package.swift"
    content = manifest.read_text()
    start, end = "// BEGIN RELEASE NATIVE BINARIES", "// END RELEASE NATIVE BINARIES"
    if content.count(start) != 1 or content.count(end) != 1:
        raise SystemExit("Invalid release manifest markers")
    block = start + "\nlet releasedNative: [String: (url: String, checksum: String)] = [\n" + "\n".join(entries) + "\n]\n"
    manifest.write_text(content[:content.index(start)] + block + content[content.index(end):])
    (args.output / "provenance.json").write_text(json.dumps({
        "source_commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
        "rust": subprocess.check_output(["rustc", "--version"], text=True).strip(),
        "xcode": subprocess.check_output(["xcodebuild", "-version"], text=True).strip(),
        "version": args.version, "repository": args.repository,
    }, indent=2) + "\n")
    print(f"Prepared {len(entries)} archives for {args.repository} {args.version}")

if __name__ == "__main__":
    main()
