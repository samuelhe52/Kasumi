#!/bin/sh
# Exercise the Xcode package link that previously pulled in four Rust runtimes.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tmp=$(mktemp -d "${TMPDIR:-/tmp}/kasumi-consumer.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
mkdir -p "$tmp/Sources/Consumer"
cat > "$tmp/Package.swift" <<'SWIFT'
// swift-tools-version: 6.2
import Foundation
import PackageDescription
let package = Package(
    name: "Consumer",
    platforms: [.macOS(.v13)],
    dependencies: [.package(name: "Kasumi", path: ProcessInfo.processInfo.environment["KASUMI_CHECKOUT"]!)],
    targets: [.executableTarget(name: "Consumer", dependencies: [
        .product(name: "KasumiMarkdownUI", package: "Kasumi"),
        .product(name: "KasumiMarkdown", package: "Kasumi"),
    ])]
)
SWIFT
cat > "$tmp/Sources/Consumer/main.swift" <<'SWIFT'
import KasumiMarkdown
import KasumiMarkdownUI

let document = MarkdownDocument(markdown: "# Native consumer\n\nA rendering test.")
let rendered = RenderedDocument(document, width: 390, style: RenderStyle())
let png = try DocumentExport.png(rendered, scale: 1)
precondition(!png.isEmpty)
print("Rendered \(png.count) bytes")
SWIFT
export KASUMI_CHECKOUT="$root"
cd "$tmp"
xcodebuild -scheme Consumer -destination 'platform=macOS,arch=arm64' -derivedDataPath "$tmp/DerivedData" CODE_SIGNING_ALLOWED=NO build
"$tmp/DerivedData/Build/Products/Debug/Consumer"
swift run Consumer
